<Application x:Class="NetworkProfileManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NetworkProfileManager.Converters">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WPF-UI 4.x base resources (must come first). App.ApplyTheme swaps
             the theme dictionary between Light and Dark at runtime. -->
        <ui:ThemesDictionary Theme="Dark"/>
        <ui:ControlsDictionary/>
        <!-- Shared text and surface styles (theme-independent) -->
        <ResourceDictionary Source="Themes/Styles.xaml"/>
        <!-- Default strings (LanguageManager swaps this at startup) -->
        <ResourceDictionary Source="Strings/En.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
      <conv:AdapterTypeToSymbolConverter x:Key="AdapterTypeToSymbol"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
