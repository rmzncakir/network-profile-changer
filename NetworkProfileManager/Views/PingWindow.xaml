<ui:FluentWindow x:Class="NetworkProfileManager.Views.PingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Ping.Title}"
        Width="480" Height="420"
        MinWidth="380" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The word comes from the string table so it follows a language switch;
         only the host is set from code. -->
    <ui:TitleBar Grid.Row="0" ShowMaximize="False" ShowMinimize="False">
      <ui:TitleBar.Header>
        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0">
          <Run Text="{DynamicResource Ping.Title}"/><Run x:Name="TitleHost"/>
        </TextBlock>
      </ui:TitleBar.Header>
    </ui:TitleBar>

    <!-- Live status: one dot, one line -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,8,20,12">
      <Ellipse x:Name="StatusDot" Width="10" Height="10"
               Fill="{DynamicResource TextFillColorTertiaryBrush}"
               VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBlock x:Name="StatusText" Text="{DynamicResource Common.Ready}"
                 FontSize="14" VerticalAlignment="Center"/>
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,0,20,16" Padding="0">
      <DockPanel>
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="16,10,16,12" Visibility="Collapsed"/>
        <ScrollViewer x:Name="ResultScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ResultStack" Margin="16,10"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource FooterBar}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button x:Name="RetryBtn" MinWidth="96" Margin="0,0,8,0"
                   Icon="{ui:SymbolIcon ArrowSync20}"
                   Content="{DynamicResource Common.Retry}"
                   Click="RetryClick"/>
        <ui:Button Content="{DynamicResource Common.Close}" MinWidth="96"
                   Click="CloseClick" IsCancel="True"/>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
