<ui:FluentWindow x:Class="NetworkProfileManager.Views.AddProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource AddProfile.TitleAdd}"
        Width="440" Height="560"
        MinWidth="380" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="DialogTitleBar"
                 Grid.Row="0"
                 Title="{DynamicResource AddProfile.TitleAdd}"
                 ShowMaximize="False" ShowMinimize="False"/>

    <!-- Inputs scroll when the window is small or text is scaled up, so the
         actions in the footer always stay reachable. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,20">
        <TextBlock Text="{DynamicResource AddProfile.NameLabel}" Style="{StaticResource FieldLabel}"/>
        <ui:TextBox x:Name="TxtName"
                    AutomationProperties.Name="{DynamicResource AddProfile.NameLabel}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
          <RadioButton Content="{DynamicResource EditBar.Dhcp}" IsChecked="{Binding IsDhcp}" Margin="0,0,24,0"/>
          <RadioButton Content="{DynamicResource EditBar.Static}" IsChecked="{Binding IsStatic}"/>
        </StackPanel>

        <StackPanel IsEnabled="{Binding IsStatic}">
          <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox AutomationProperties.Name="{DynamicResource EditBar.Ip}"
                      Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

          <TextBlock Text="{DynamicResource EditBar.Subnet}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox AutomationProperties.Name="{DynamicResource EditBar.Subnet}"
                      PlaceholderText="255.255.255.0"
                      Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

          <TextBlock Text="{DynamicResource AddProfile.GatewayLabel}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox AutomationProperties.Name="{DynamicResource AddProfile.GatewayLabel}"
                      Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{DynamicResource EditBar.PrimaryDns}" Style="{StaticResource FieldLabel}"/>
              <ui:TextBox AutomationProperties.Name="{DynamicResource EditBar.PrimaryDns}"
                          Text="{Binding PrimaryDns, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource AddProfile.SecondaryDnsLabel}" Style="{StaticResource FieldLabel}"/>
              <ui:TextBox AutomationProperties.Name="{DynamicResource AddProfile.SecondaryDnsLabel}"
                          Text="{Binding SecondaryDns, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Style="{StaticResource FooterBar}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="{DynamicResource Common.Cancel}" MinWidth="96" Margin="0,0,8,0"
                   Click="Cancel_Click" IsCancel="True"/>
        <ui:Button Content="{DynamicResource Common.Save}" Appearance="Primary" MinWidth="96"
                   Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
