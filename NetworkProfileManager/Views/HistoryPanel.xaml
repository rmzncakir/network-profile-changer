<UserControl x:Class="NetworkProfileManager.Views.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!-- A plain list rather than a DataGrid: it lives inside the page's scroll
       viewer, and a DataGrid would swallow the mouse wheel. -->
  <StackPanel>
    <DockPanel Margin="0,0,0,8">
      <ui:Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6"
                 Icon="{ui:SymbolIcon Delete20}"
                 Command="{Binding ClearHistoryCommand}"
                 ToolTip="{DynamicResource History.ClearTooltip}"
                 AutomationProperties.Name="{DynamicResource History.ClearTooltip}"/>
      <TextBlock Text="{DynamicResource History.Header}" Style="{StaticResource SectionHeaderText}"/>
    </DockPanel>

    <Border Style="{StaticResource Card}" Padding="0" Grid.IsSharedSizeScope="True">
      <StackPanel>
        <TextBlock Text="{DynamicResource History.Empty}" FontSize="14" Margin="16">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAdapter.History.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Grid Margin="16,10,8,6">
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAdapter.History.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Date"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Profile"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{DynamicResource History.ColumnDate}"
                     Style="{StaticResource CaptionText}" Margin="0,0,24,0"/>
          <TextBlock Grid.Column="1" Text="{DynamicResource History.ColumnChange}"
                     Style="{StaticResource CaptionText}"/>
          <TextBlock Grid.Column="2" Text="{DynamicResource History.ColumnProfile}"
                     Style="{StaticResource CaptionText}" Margin="16,0,0,0"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding SelectedAdapter.History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0" Padding="16,4,8,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Date"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Profile"/>
                    <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0"
                             Style="{StaticResource CaptionText}"
                             Text="{Binding Timestamp, StringFormat=\{0:dd.MM HH:mm\}}"/>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding OldIp, Mode=OneWay}"/>
                    <Run Text="→" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <Run Text="{Binding NewIp, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
                             Style="{StaticResource CaptionText}" MaxWidth="160"
                             Text="{Binding ProfileName}"/>
                  <ui:Button Grid.Column="3" HorizontalAlignment="Right"
                             Style="{StaticResource SubtleButton}" Padding="6"
                             Icon="{ui:SymbolIcon ArrowUndo16}"
                             ToolTip="{DynamicResource History.RevertTooltip}"
                             AutomationProperties.Name="{DynamicResource History.RevertTooltip}"
                             Command="{Binding DataContext.RevertCommand,
                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
