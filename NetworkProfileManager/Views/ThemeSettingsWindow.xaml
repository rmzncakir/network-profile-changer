<ui:FluentWindow x:Class="NetworkProfileManager.Views.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="460" Height="380"
        MinWidth="400" MinHeight="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{DynamicResource Settings.Title}"
                 ShowMaximize="False" ShowMinimize="False"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,20">

        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
          <DockPanel>
            <ComboBox x:Name="CmbTheme" DockPanel.Dock="Right" MinWidth="190"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{DynamicResource Settings.ColorTheme}"
                      SelectionChanged="Theme_Changed">
              <ComboBoxItem Tag="System" Content="{DynamicResource Settings.ThemeSystem}"/>
              <ComboBoxItem Tag="Light"  Content="{DynamicResource Settings.ThemeLight}"/>
              <ComboBoxItem Tag="Dark"   Content="{DynamicResource Settings.ThemeDark}"/>
            </ComboBox>
            <TextBlock Text="{DynamicResource Settings.ColorTheme}" FontSize="14" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
          <DockPanel>
            <ComboBox x:Name="CmbLanguage" DockPanel.Dock="Right" MinWidth="190"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{DynamicResource Settings.Language}"
                      SelectionChanged="Language_Changed">
              <ComboBoxItem x:Name="LangSystemItem" Tag="System"/>
              <ComboBoxItem Tag="tr" Content="{DynamicResource Settings.LanguageTurkish}"/>
              <ComboBoxItem Tag="en" Content="{DynamicResource Settings.LanguageEnglish}"/>
            </ComboBox>
            <TextBlock Text="{DynamicResource Settings.Language}" FontSize="14" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <DockPanel>
            <ui:ToggleSwitch x:Name="TogStartup"
                             DockPanel.Dock="Right" VerticalAlignment="Center"
                             AutomationProperties.Name="{DynamicResource Settings.StartupTitle}"
                             Checked="StartupToggle_Changed"
                             Unchecked="StartupToggle_Changed"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Settings.StartupTitle}" FontSize="14"/>
              <TextBlock Text="{DynamicResource Settings.StartupHint}"
                         Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Style="{StaticResource FooterBar}">
      <ui:Button Content="{DynamicResource Common.Close}"
                 HorizontalAlignment="Right" MinWidth="96"
                 Click="CloseClick" IsCancel="True"/>
    </Border>
  </Grid>
</ui:FluentWindow>
