<UserControl x:Class="NetworkProfileManager.Views.AdapterListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <DockPanel Margin="8,4,8,8">
    <DockPanel DockPanel.Dock="Top" Margin="12,8,0,8">
      <ui:Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6"
                 Icon="{ui:SymbolIcon ArrowSync20}"
                 Command="{Binding RefreshCommand}"
                 ToolTip="{DynamicResource Common.Refresh}"
                 AutomationProperties.Name="{DynamicResource Common.Refresh}"/>
      <TextBlock Text="{DynamicResource Adapters.Header}" Style="{StaticResource SectionHeaderText}"/>
    </DockPanel>

    <!-- Navigation-style list: selection is a fill plus the accent pill, nothing else -->
    <ListBox ItemsSource="{Binding Adapters}"
             SelectedItem="{Binding SelectedAdapter}"
             Background="Transparent" BorderThickness="0" Padding="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">

      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0,1"/>
          <Setter Property="Padding" Value="12,8"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
          <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid>
                  <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"/>
                  <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          Visibility="Collapsed"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsSelected" Value="True"/>
                      <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>

      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ToolTip="{Binding Description}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon x:Name="TypeIcon" Grid.Column="0"
                           Symbol="{Binding AdapterType, Converter={StaticResource AdapterTypeToSymbol}}"
                           FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="14"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel x:Name="IpLine" Orientation="Horizontal">
                <TextBlock Text="{Binding CurrentIp}" Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="DhcpText" Text=" · DHCP" Style="{StaticResource CaptionText}"
                           Visibility="Collapsed"/>
              </StackPanel>
              <TextBlock x:Name="OfflineLine" Text="{DynamicResource Adapters.NotConnected}"
                         Style="{StaticResource CaptionText}" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>

          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDhcp}" Value="True">
              <Setter TargetName="DhcpText" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- Many adapters (VPN, Bluetooth) are normally down; dim, don't alarm -->
            <DataTrigger Binding="{Binding IsConnected}" Value="False">
              <Setter TargetName="IpLine" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="OfflineLine" Property="Visibility" Value="Visible"/>
              <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
              <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
