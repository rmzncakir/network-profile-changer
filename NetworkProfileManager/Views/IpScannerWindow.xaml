<ui:FluentWindow x:Class="NetworkProfileManager.Views.IpScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Scanner.Title}"
        Width="980" Height="640"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{DynamicResource Scanner.Title}"
                 ShowMaximize="False" ShowMinimize="False"/>

    <!-- Scan settings: labelled fields, then the options that change how it probes -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,8,20,0" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" IsEnabled="{Binding IsNotScanning}">
          <StackPanel Width="160" Margin="0,0,12,0">
            <TextBlock Text="{DynamicResource Scanner.StartIp}" Style="{StaticResource FieldLabel}"/>
            <ui:TextBox Text="{Binding StartIp, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{DynamicResource Scanner.StartIp}"/>
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,0">
            <TextBlock Text="{DynamicResource Scanner.EndIp}" Style="{StaticResource FieldLabel}"/>
            <ui:TextBox Text="{Binding EndIp, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{DynamicResource Scanner.EndIp}"/>
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,0">
            <TextBlock Text="{DynamicResource Scanner.TimeoutMs}" Style="{StaticResource FieldLabel}"/>
            <ui:NumberBox Value="{Binding TimeoutMs, Mode=TwoWay}"
                          Minimum="100" Maximum="10000" SmallChange="100"
                          SpinButtonPlacementMode="Inline"
                          AutomationProperties.Name="{DynamicResource Scanner.TimeoutMs}"/>
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,0">
            <TextBlock Text="{DynamicResource Scanner.MaxParallel}" Style="{StaticResource FieldLabel}"/>
            <ui:NumberBox Value="{Binding MaxParallel, Mode=TwoWay}"
                          Minimum="1" Maximum="128" SmallChange="16"
                          SpinButtonPlacementMode="Inline"
                          AutomationProperties.Name="{DynamicResource Scanner.MaxParallel}"/>
          </StackPanel>
        </WrapPanel>

        <!-- Start and Stop share one slot: only the one that applies is shown -->
        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
          <ui:Button Appearance="Primary" MinWidth="110"
                     Icon="{ui:SymbolIcon Play20}"
                     Content="{DynamicResource Scanner.StartButton}"
                     Command="{Binding StartCommand}"
                     Visibility="{Binding IsNotScanning, Converter={StaticResource BoolToVis}}"/>
          <ui:Button MinWidth="110"
                     Icon="{ui:SymbolIcon Stop20}"
                     Content="{DynamicResource Scanner.StopButton}"
                     Command="{Binding StopCommand}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
          <CheckBox Content="{DynamicResource Scanner.UseArp}"
                    ToolTip="{DynamicResource Scanner.UseArpTooltip}"
                    IsChecked="{Binding UseArp, Mode=TwoWay}"
                    IsEnabled="{Binding IsNotScanning}"
                    VerticalAlignment="Center" Margin="0,0,20,0"/>
          <CheckBox Content="{DynamicResource Scanner.UseTcpProbe}"
                    ToolTip="{DynamicResource Scanner.UseTcpProbeTooltip}"
                    IsChecked="{Binding UseTcpProbe, Mode=TwoWay}"
                    IsEnabled="{Binding IsNotScanning}"
                    VerticalAlignment="Center" Margin="0,0,20,0"/>
          <CheckBox Content="{DynamicResource Monitor.Enable}"
                    ToolTip="{DynamicResource Monitor.EnableTooltip}"
                    IsChecked="{Binding IsMonitoring, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{DynamicResource Monitor.Interval}" Style="{StaticResource CaptionText}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ui:NumberBox Width="110"
                        Value="{Binding MonitorIntervalMinutes, Mode=TwoWay}"
                        Minimum="1" Maximum="180" SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        AutomationProperties.Name="{DynamicResource Monitor.Interval}"/>
        </WrapPanel>
      </Grid>
    </Border>

    <ProgressBar Grid.Row="2" Margin="20,12,20,0" Height="4"
                 Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="20,12,20,16" Padding="0">
      <DataGrid ItemsSource="{Binding Results}"
                SelectedItem="{Binding SelectedResult}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0">

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOnline}" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{DynamicResource Scanner.ColumnIp}" Width="170" SortMemberPath="IpAddress">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding IpAddress}" VerticalAlignment="Center"/>
                  <ui:Button Style="{StaticResource SubtleButton}" Padding="4" Margin="4,0,0,0"
                             VerticalAlignment="Center"
                             Icon="{ui:SymbolIcon Copy16}"
                             ToolTip="{DynamicResource Adapters.CopyIpTooltip}"
                             AutomationProperties.Name="{DynamicResource Adapters.CopyIpTooltip}"
                             Tag="{Binding IpAddress}"
                             Click="CopyIp_Click"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource Scanner.ColumnStatus}" Width="110" SortMemberPath="IsOnline">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{DynamicResource Scanner.StatusOffline}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                          <Setter Property="Text" Value="{DynamicResource Scanner.StatusOnline}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{DynamicResource Scanner.ColumnFoundBy}"      Binding="{Binding FoundByLabel}"      Width="100"/>
          <DataGridTextColumn Header="{DynamicResource Scanner.ColumnResponseTime}" Binding="{Binding ResponseTimeLabel}" Width="90"/>
          <DataGridTextColumn Header="{DynamicResource Scanner.ColumnHostname}"     Binding="{Binding HostName}"          Width="*"/>
          <DataGridTextColumn Header="{DynamicResource Scanner.ColumnDeviceType}"   Binding="{Binding DeviceType}"        Width="160"/>
          <DataGridTextColumn Header="{DynamicResource Scanner.ColumnMac}"          Binding="{Binding MacAddress}"        Width="160"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource FooterBar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0"
                     Icon="{ui:SymbolIcon Copy20}"
                     Content="{DynamicResource Common.Copy}"
                     Click="CopySelected_Click"/>
          <ui:Button Margin="0,0,8,0"
                     Icon="{ui:SymbolIcon ArrowExportLtr20}"
                     Content="CSV"
                     Command="{Binding ExportCommand}"/>
          <ui:Button Appearance="Primary"
                     Icon="{ui:SymbolIcon ArrowRight20}"
                     Content="{DynamicResource Scanner.ApplyIp}"
                     Command="{Binding ApplyIpCommand}"
                     CommandParameter="{Binding SelectedResult}"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
