<ui:FluentWindow x:Class="NetworkProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:NetworkProfileManager.ViewModels"
        xmlns:views="clr-namespace:NetworkProfileManager.Views"
        Title="{DynamicResource App.Title}"
        Icon="Assets/icon.ico"
        Width="1000" Height="720"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

  <ui:FluentWindow.DataContext>
    <vm:MainViewModel/>
  </ui:FluentWindow.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{DynamicResource App.Title}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" Width="16" Height="16"/>
      </ui:TitleBar.Icon>
      <ui:TitleBar.TrailingContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <ui:Button Style="{StaticResource SubtleButton}" Padding="10,6" Margin="0,0,2,0"
                     Icon="{ui:SymbolIcon SearchInfo20}"
                     Content="{DynamicResource MainWindow.IpScannerButton}"
                     ToolTip="{DynamicResource MainWindow.IpScannerTooltip}"
                     Click="OpenScannerClick"/>
          <ui:Button Style="{StaticResource SubtleButton}" Padding="8,6"
                     Icon="{ui:SymbolIcon Settings20}"
                     ToolTip="{DynamicResource MainWindow.SettingsTooltip}"
                     AutomationProperties.Name="{DynamicResource MainWindow.SettingsTooltip}"
                     Click="OpenThemeClick"/>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Adapters sit directly on Mica, like a navigation pane -->
      <views:AdapterListPanel Grid.Column="0"/>

      <!-- Selected adapter page: the content layer over Mica -->
      <Border Grid.Column="1"
              Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1,1,0,0"
              CornerRadius="8,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.RowSpan="2"
                     Text="{DynamicResource Profiles.NoAdapterSelected}"
                     FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ScrollViewer x:Name="RightPanel" Grid.Row="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="32,24,32,32">

              <!-- ── Adapter header: name, then its live settings as plain facts ── -->
              <TextBlock Text="{Binding SelectedAdapter.Name}" Style="{StaticResource PageTitleText}"/>
              <TextBlock Text="{Binding SelectedAdapter.Description}"
                         Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>

              <WrapPanel Margin="0,0,0,8">
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CurrentIpText" FontSize="14" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding SelectedAdapter.CurrentIp}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedAdapter.IsConnected}" Value="False">
                              <Setter Property="Text" Value="{DynamicResource Adapters.NotConnected}"/>
                              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ui:Button Style="{StaticResource SubtleButton}" Padding="4" Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon Copy16}"
                               Tag="{Binding SelectedAdapter.CurrentIp}"
                               ToolTip="{DynamicResource Adapters.CopyIpTooltip}"
                               AutomationProperties.Name="{DynamicResource Adapters.CopyIpTooltip}"
                               Visibility="{Binding SelectedAdapter.IsConnected, Converter={StaticResource BoolToVis}}"
                               Click="CopyIp_Click"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource EditBar.Subnet}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentSubnet}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource EditBar.Gateway}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentGateway}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource Adapter.Dns}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentDnsDisplay}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource Adapter.Mode}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock FontSize="14">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{DynamicResource EditBar.Static}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedAdapter.IsDhcp}" Value="True">
                            <Setter Property="Text" Value="{DynamicResource EditBar.Dhcp}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </WrapPanel>

              <!-- ── Profiles ── -->
              <views:ProfilePanel/>

              <!-- ── Ping ── -->
              <TextBlock Text="{DynamicResource EditBar.PingHeader}"
                         Style="{StaticResource SectionHeaderText}" Margin="0,28,0,8"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="{DynamicResource EditBar.PingPlaceholder}"
                                Text="{Binding SelectedAdapter.PingTarget, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"/>
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" MinWidth="80"
                               Content="{DynamicResource EditBar.PingButton}"
                               Command="{Binding PingCommand}"/>
                    <ui:Button Grid.Column="2" Margin="4,0,0,0" Padding="8,6"
                               Style="{StaticResource SubtleButton}"
                               Icon="{ui:SymbolIcon Open20}"
                               ToolTip="{DynamicResource EditBar.PingWindowTooltip}"
                               AutomationProperties.Name="{DynamicResource EditBar.PingWindowTooltip}"
                               Click="OpenPingWindowClick"/>
                  </Grid>

                  <!-- Result: the dot carries the colour, the text stays neutral -->
                  <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedAdapter.PingResult}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedAdapter.PingSuccess}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedAdapter.IsPinging}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SelectedAdapter.PingResult}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- ── History ── -->
              <views:HistoryPanel Margin="0,28,0,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ── Manual configuration, pinned: vendor presets and Apply never scroll away ── -->
          <Border Grid.Row="1"
                  BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="32,14,32,18">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <!-- One click fills the fields; it never applies on its own -->
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource EditBar.Presets}"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="{DynamicResource EditBar.PresetsTooltip}"/>
                <ItemsControl ItemsSource="{Binding VendorPresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Button Content="{Binding Name}" ToolTip="{Binding Description}"
                                 FontSize="13" Padding="10,4" Margin="0,0,6,4"
                                 Command="{Binding DataContext.ApplyPresetCommand,
                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="{DynamicResource EditBar.Dhcp}"
                             IsChecked="{Binding SelectedAdapter.EditIsDhcp, FallbackValue=False}"
                             Margin="0,0,24,0"/>
                <RadioButton Content="{DynamicResource EditBar.Static}"
                             IsChecked="{Binding SelectedAdapter.EditIsStatic, FallbackValue=True}"/>
              </StackPanel>

              <Grid>
                <Grid.Resources>
                  <!-- Address fields only apply to a static setup; Apply shares the
                       grid but must stay enabled, since it also applies DHCP. -->
                  <Style x:Key="StaticOnlyField" TargetType="StackPanel">
                    <Setter Property="IsEnabled" Value="{Binding SelectedAdapter.EditIsStatic, FallbackValue=False}"/>
                  </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditIp, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AutomationProperties.Name="{DynamicResource EditBar.Ip}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.Subnet}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditSubnet, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AutomationProperties.Name="{DynamicResource EditBar.Subnet}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.Gateway}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditGateway, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AutomationProperties.Name="{DynamicResource EditBar.Gateway}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.PrimaryDns}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditPrimaryDns, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{DynamicResource EditBar.PrimaryDns}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.SecondaryDns}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditSecondaryDns, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{DynamicResource EditBar.SecondaryDns}"/>
                </StackPanel>

                <!-- Apply takes the free slot next to the DNS fields -->
                <ui:Button Grid.Row="2" Grid.Column="4"
                           Content="{DynamicResource Common.Apply}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                           Command="{Binding ApplyCommand}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Busy overlay: blocks input while netsh runs (and UAC may be up) -->
    <Grid Grid.Row="1"
          Background="{DynamicResource SmokeFillColorDefaultBrush}"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
              BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24,16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0,0,12,0"/>
          <TextBlock Text="{DynamicResource MainWindow.BusyApplying}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <ui:SnackbarPresenter x:Name="RootSnackbar"
                          Grid.Row="0" Grid.RowSpan="2"
                          VerticalAlignment="Bottom"
                          Margin="16,0,16,12"/>

    <ui:ContentDialogHost x:Name="RootDialogHost"
                          Grid.Row="0" Grid.RowSpan="2"/>
  </Grid>
</ui:FluentWindow>
