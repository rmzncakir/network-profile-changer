<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ── Colors ────────────────────────────────────────────────────  -->
    <Color x:Key="BgDeepColor">#0D0D1A</Color>
    <Color x:Key="BgBaseColor">#12121F</Color>
    <Color x:Key="BgSurfaceColor">#1A1A2E</Color>
    <Color x:Key="BgCardColor">#1E1E35</Color>
    <Color x:Key="BgHoverColor">#252540</Color>
    <Color x:Key="AccentPrimaryColor">#4FC3F7</Color>
    <Color x:Key="AccentHoverColor">#81D4FA</Color>
    <Color x:Key="AccentPressColor">#0288D1</Color>
    <Color x:Key="AccentGreenColor">#00E676</Color>
    <Color x:Key="AccentOrangeColor">#FF6D00</Color>
    <Color x:Key="TextPrimaryColor">#ECEFF1</Color>
    <Color x:Key="TextSecondaryColor">#90A4AE</Color>
    <Color x:Key="TextMutedColor">#546E7A</Color>
    <Color x:Key="StatusConnectedColor">#00E676</Color>
    <Color x:Key="StatusDisconnectedColor">#EF5350</Color>
    <Color x:Key="BorderColor">#252545</Color>
    <Color x:Key="DangerColor">#EF5350</Color>

    <!--  ── Brushes ────────────────────────────────────────────────────  -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="{StaticResource AccentPressColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusConnectedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource BgDeepColor}" />

    <!--  ── Semantic UI brushes (theme-switchable) ──────────────────────  -->
    <!--  DataGrid alternating row background  -->
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#08080F" />
    <!--  Selected row in DataGrid / ListBox  -->
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#2A2A55" />
    <!--  Selected adapter card background  -->
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#16162A" />
    <!--  Adapter icon badge backgrounds  -->
    <SolidColorBrush x:Key="BadgeConnectedBrush" Color="#334FC3F7" />
    <SolidColorBrush x:Key="BadgeDisconnectedBrush" Color="#44EF5350" />
    <!--  Icon foreground on disconnected (red) badge — white for contrast in dark  -->
    <SolidColorBrush x:Key="BadgeDisconnectedIconBrush" Color="#FFFFFF" />
    <!--  DHCP badge background  -->
    <SolidColorBrush x:Key="DhcpBadgeBrush" Color="#2200E676" />
    <!--  Modal busy-overlay scrim — theme-switchable so Light mode doesn't go black  -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC0D0D1A" />
    <!--  Warning / TTL-expired accent (orange)  -->
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource AccentOrangeColor}" />

    <!--  ── RadioButton ─────────────────────────────────────────────────  -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  ── Panel header border ─────────────────────────────────────────  -->
    <Style x:Key="PanelHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!--  ── Header TextBlock ────────────────────────────────────────────  -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ── Field label ─────────────────────────────────────────────────  -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
